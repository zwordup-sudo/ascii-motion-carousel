# DEVING OS v0.4 - GGA local review policy
PROVIDER="opencode"
FILE_PATTERNS="*.js,*.mjs,*.cjs,*.ts,*.tsx,*.jsx,*.json,*.html,*.css,*.md,*.yml,*.yaml"
EXCLUDE_PATTERNS="*.env,*.env.*,*.pem,*.key,*.p12,*.pfx,*.jks,*.keystore,*credentials*.json,*auth.json,*mcp-auth.json,*.local,*lock*,*.min.js,dist/*,build/*,node_modules/*,.opencode/*,.deving/evidence/*"
RULES_FILE="docs/DEVING-GGA-RULES.md"
STRICT_MODE="true"
TIMEOUT="300"
